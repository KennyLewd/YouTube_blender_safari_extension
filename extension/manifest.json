{
  "manifest_version": 3,
  "name": "Ambient Light for Safari",
  "description": "Video-matched ambient light for YouTube in Safari on Mac.",
  "version": "1.2.8",
  "homepage_url": "https://github.com/WesselKroos/youtube-ambilight",
  "author": "Safari adaptation of Wessel Kroos’s Ambient light for YouTube",
  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "128": "images/icon-128.png"
  },
  "action": {
    "default_icon": {
      "16": "images/icon-16.png",
      "24": "images/icon-24.png",
      "32": "images/icon-32.png"
    },
    "default_popup": "options.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "exclude_matches": [
        "https://www.youtube.com/live_chat*",
        "https://www.youtube.com/embed/*"
      ],
      "run_at": "document_start",
      "js": [
        "scripts/injected.js"
      ],
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "exclude_matches": [
        "https://www.youtube.com/live_chat*",
        "https://www.youtube.com/embed/*"
      ],
      "js": [
        "scripts/content.js"
      ],
      "run_at": "document_start",
      "css": [
        "styles/edge-blend.css",
        "styles/header-glass.css"
      ]
    },
    {
      "matches": [
        "https://www.youtube.com/embed/*"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "js": [
        "scripts/injected.js"
      ],
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.youtube.com/embed/*"
      ],
      "js": [
        "scripts/content.js"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "css": [
        "styles/edge-blend.css",
        "styles/header-glass.css"
      ]
    },
    {
      "matches": [
        "https://www.youtube.com/live_chat*"
      ],
      "exclude_matches": [
        "https://www.youtube.com/live_chat?is_popout=1*"
      ],
      "css": [
        "styles/live-chat.css"
      ],
      "js": [
        "scripts/live-chat.js"
      ],
      "all_frames": true,
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "styles/content.css",
        "scripts/content-main.js",
        "images/noise-1.png",
        "images/noise-2.png",
        "images/noise-3.png",
        "scripts/desktop-content.js",
        "scripts/edge-blend.js",
        "scripts/video-frame-loop.js",
        "scripts/header-glass.js",
        "scripts/canvas-blur.js",
        "scripts/edge-raster.js"
      ],
      "matches": [
        "https://www.youtube.com/*"
      ]
    }
  ],
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.youtube.com/*"
  ]
}
